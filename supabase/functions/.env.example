# Local Supabase Edge Function configuration. Do not commit real secrets.
TURNSTILE_SECRET=replace-with-your-turnstile-secret
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Local-only: permits the official always-pass dummy secret without action/hostname claims.
# It stays disabled unless this exact dummy secret and local-only hostnames are also configured.
TURNSTILE_TEST_MODE=false
